# /etc/systemd/system/vihea.service  — keeps the API running 24/7 and restarts it after a crash or reboot
# Use ONE worker (-w 1): the background jobs (reminders, Telegram, summaries) must not run twice.
[Unit]
Description=Vihea Chamnaleu attendance API
After=network.target mysql.service

[Service]
User=www-data
WorkingDirectory=/var/www/vihea/backend
EnvironmentFile=/var/www/vihea/backend/.env
ExecStart=/var/www/vihea/backend/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
